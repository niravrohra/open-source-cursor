{
  "name": "rursor-ai",
  "displayName": "Rursor AI",
  "description": "Rursor 1.0 Omni-Studio: Multi-agent APFS CoW Swarm, native Chromium CDP Browser & Video Proof, PowerPoint/MP4/Office/GenUI Studio, persistent @docs & MCP Registry, Infinite Design-to-Code Canvas, and Tab/NES AI IDE.",
  "publisher": "rursor",
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "themes": [
      {
        "id": "Rursor Obsidian",
        "label": "Rursor Obsidian",
        "uiTheme": "vs-dark",
        "path": "./themes/rursor-obsidian-dark.json"
      }
    ],
    "configurationDefaults": {
      "chat.commandCenter.enabled": false,
      "window.commandCenter": true,
      "workbench.layoutControl.enabled": true,
      "editor.inlineSuggest.enabled": true,
      "editor.smoothScrolling": true,
      "editor.cursorBlinking": "smooth",
      "editor.cursorSmoothCaretAnimation": "on"
    },
    "viewsContainers": {
      "auxiliarybar": [
        {
          "id": "rursor-sidebar",
          "title": "Rursor AI",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "views": {
      "rursor-sidebar": [
        {
          "type": "webview",
          "id": "rursor.agentView",
          "name": "Agent"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "rursor.canvasEditor",
        "displayName": "Rursor Design-to-Code Canvas",
        "selector": [
          {
            "filenamePattern": "*.rursor.canvas"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "rursor.openSettings",
        "title": "Rursor: Open Rursor Settings"
      },
      {
        "command": "rursor.setApiKey",
        "title": "Rursor: Set Gemini API Key"
      },
      {
        "command": "rursor.setAnthropicApiKey",
        "title": "Rursor: Set Anthropic API Key"
      },
      {
        "command": "rursor.setOpenAiApiKey",
        "title": "Rursor: Set OpenAI API Key"
      },
      {
        "command": "rursor.status",
        "title": "Rursor: Show Sidecar Status"
      },
      {
        "command": "rursor.reindex",
        "title": "Rursor: Reindex Workspace"
      },
      {
        "command": "rursor.inlineEdit",
        "title": "Rursor: Inline Edit"
      },
      {
        "command": "rursor.inlineEditInset",
        "title": "Rursor: Floating Inline Edit Composer"
      },
      {
        "command": "rursor.fixDiagnostics",
        "title": "Rursor: Fix Diagnostics"
      },
      {
        "command": "rursor.acceptInlineEdit",
        "title": "Rursor: Accept Inline Edit"
      },
      {
        "command": "rursor.revertInlineEdit",
        "title": "Rursor: Revert Inline Edit"
      },
      {
        "command": "rursor.refineInlineEdit",
        "title": "Rursor: Refine Inline Edit"
      },
      {
        "command": "rursor.acceptNextEdit",
        "title": "Rursor: Accept Next Edit"
      },
      {
        "command": "rursor.dismissNextEdit",
        "title": "Rursor: Dismiss Next Edit"
      },
      {
        "command": "rursor.jumpToNextEdit",
        "title": "Rursor: Jump to Next Edit"
      },
      {
        "command": "rursor.acceptNextWord",
        "title": "Rursor: Accept Next Word"
      },
      {
        "command": "rursor.toggleAutocomplete",
        "title": "Rursor: Toggle Tab Autocomplete"
      },
      {
        "command": "rursor.openAgent",
        "title": "Rursor: Open Agent Panel"
      },
      {
        "command": "rursor.voicePrompt",
        "title": "Rursor: Voice Prompt (Hold / Toggle)"
      },
      {
        "command": "rursor.showTelemetry",
        "title": "Rursor: Show Latency, Cache & Cost Telemetry"
      },
      {
        "command": "rursor.openMultiDiff",
        "title": "Rursor: Review All AI File Changes (Multi-Diff)"
      },
      {
        "command": "rursor.fixLastTerminalFailure",
        "title": "Rursor: Fix Last Terminal Failure with AI"
      },
      {
        "command": "rursor.debugExplainStop",
        "title": "Rursor: Explain Active Debugger Stop / Exception"
      },
      {
        "command": "rursor.reviewGitDiff",
        "title": "Rursor: AI Code Review on Git Diff"
      },
      {
        "command": "rursor.clearReviewComments",
        "title": "Rursor: Clear AI Code Review Comments"
      },
      {
        "command": "rursor.reloadMcp",
        "title": "Rursor: Reload MCP Servers"
      },
      {
        "command": "rursor.openPreview",
        "title": "Rursor: Open Web Preview"
      },
      {
        "command": "rursor.restoreCheckpoint",
        "title": "Rursor: Restore Agent Checkpoint"
      },
      {
        "command": "rursor.manageWorktrees",
        "title": "Rursor: Manage Git Worktree Sandboxes"
      },
      {
        "command": "rursor.manageCowClones",
        "title": "Rursor: Manage macOS APFS Copy-on-Write Sandboxes"
      },
      {
        "command": "rursor.missionControl",
        "title": "Rursor: Open Multi-Agent Swarm Mission Control"
      },
      {
        "command": "rursor.openMissionControl",
        "title": "Rursor: Launch Swarm Mission Control"
      },
      {
        "command": "rursor.openModelArena",
        "title": "Rursor: Run Best-of-N Model Arena"
      },
      {
        "command": "rursor.openBrowserStudio",
        "title": "Rursor: Open Native Chromium Browser & Computer-Use Studio"
      },
      {
        "command": "rursor.openArtifactStudio",
        "title": "Rursor: Open Multimodal Media, Slide Deck & Office Studio"
      },
      {
        "command": "rursor.createSlideDeck",
        "title": "Rursor: Create PowerPoint (.pptx) & Interactive Slide Deck"
      },
      {
        "command": "rursor.createExplainerVideo",
        "title": "Rursor: Create Explainer Video (.mp4)"
      },
      {
        "command": "rursor.previewArtifact",
        "title": "Rursor: Preview Studio Artifact (Deck / Video / Office)"
      },
      {
        "command": "rursor.addDocsSource",
        "title": "Rursor: Crawl & Index Documentation Site (@docs)"
      },
      {
        "command": "rursor.manageDocsSources",
        "title": "Rursor: Manage Indexed @docs Documentation Sources"
      },
      {
        "command": "rursor.installMcpPreset",
        "title": "Rursor: 1-Click Install MCP Server from Store"
      },
      {
        "command": "rursor.openCanvas",
        "title": "Rursor: Open Infinite Visual Design-to-Code Canvas"
      }
    ],
    "keybindings": [
      {
        "command": "rursor.missionControl",
        "key": "cmd+shift+m",
        "mac": "cmd+shift+m"
      },
      {
        "command": "rursor.openBrowserStudio",
        "key": "cmd+shift+b",
        "mac": "cmd+shift+b"
      },
      {
        "command": "rursor.openArtifactStudio",
        "key": "cmd+shift+a",
        "mac": "cmd+shift+a"
      },
      {
        "command": "rursor.openCanvas",
        "key": "cmd+shift+c",
        "mac": "cmd+shift+c"
      },
      {
        "command": "rursor.inlineEdit",
        "key": "cmd+k",
        "mac": "cmd+k",
        "when": "editorTextFocus"
      },
      {
        "command": "rursor.openAgent",
        "key": "cmd+l",
        "mac": "cmd+l"
      },
      {
        "command": "rursor.openSettings",
        "key": "cmd+shift+j",
        "mac": "cmd+shift+j"
      },
      {
        "command": "rursor.voicePrompt",
        "key": "cmd+shift+v",
        "mac": "cmd+shift+v",
        "when": "editorTextFocus"
      },
      {
        "command": "rursor.openMultiDiff",
        "key": "alt+cmd+d",
        "mac": "alt+cmd+d"
      },
      {
        "command": "rursor.acceptInlineEdit",
        "key": "cmd+y",
        "mac": "cmd+y",
        "when": "editorTextFocus && rursor.hasActiveInlineEdit"
      },
      {
        "command": "rursor.revertInlineEdit",
        "key": "cmd+n",
        "mac": "cmd+n",
        "when": "editorTextFocus && rursor.hasActiveInlineEdit"
      },
      {
        "command": "rursor.acceptNextEdit",
        "key": "tab",
        "mac": "tab",
        "when": "editorTextFocus && rursor.hasNextEdit"
      },
      {
        "command": "rursor.jumpToNextEdit",
        "key": "tab",
        "mac": "tab",
        "when": "editorTextFocus && rursor.hasJumpTarget && !rursor.hasNextEdit"
      },
      {
        "command": "rursor.dismissNextEdit",
        "key": "escape",
        "mac": "escape",
        "when": "editorTextFocus && (rursor.hasNextEdit || rursor.hasJumpTarget)"
      },
      {
        "command": "rursor.acceptNextWord",
        "key": "cmd+right",
        "mac": "cmd+right",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "Rursor AI",
      "properties": {
        "rursor.defaultModel": {
          "type": "string",
          "default": "gemini-3.8-flash",
          "enum": [
            "auto",
            "gemini-3.8-flash",
            "gemini-3.1-pro-preview",
            "gemini-3.5-flash-lite",
            "claude-sonnet-4-20250514",
            "claude-3-5-haiku-latest",
            "gpt-4o-mini",
            "o3-mini"
          ],
          "description": "Default model or Smart Router mode for Rursor Agent and Inline Edit."
        },
        "rursor.agent.permissionProfile": {
          "type": "string",
          "default": "safe-auto",
          "enum": [
            "read-only",
            "safe-auto",
            "full-auto"
          ],
          "description": "macOS Seatbelt sandbox and command execution permission profile for Rursor Agent."
        },
        "rursor.agent.sandboxAllowNetwork": {
          "type": "boolean",
          "default": false,
          "description": "Allow outbound network access inside macOS Seatbelt sandboxed Agent commands."
        },
        "rursor.agent.autoVerify": {
          "type": "boolean",
          "default": false,
          "description": "Automatically run detected project test/typecheck commands after Agent edits and loop on failures."
        },
        "rursor.agent.thinkingBudget": {
          "type": "number",
          "default": 0,
          "description": "Optional thinking token budget for Gemini 2.5 reasoning turns (0 = automatic)."
        },
        "rursor.agent.promptCache": {
          "type": "boolean",
          "default": true,
          "description": "Enable Gemini Context Caching for large static project rules and memory prefixes."
        },
        "rursor.agent.usePty": {
          "type": "boolean",
          "default": true,
          "description": "Run Agent shell commands inside a real PTY via portable-pty in the Rust sidecar."
        },
        "rursor.autocomplete.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable low-latency Tab ghost-text autocomplete via Gemini or local Apple Silicon models."
        },
        "rursor.autocomplete.nesEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable multi-line Next-Edit Suggestion (NES) and Tab-to-Jump predictions."
        },
        "rursor.autocomplete.model": {
          "type": "string",
          "default": "gemini-3.5-flash-lite",
          "description": "Gemini model used for Tab autocomplete and NES."
        },
        "rursor.autocomplete.backend": {
          "type": "string",
          "default": "gemini",
          "enum": [
            "gemini",
            "auto",
            "ollama",
            "mlx"
          ],
          "description": "Backend used for Tab autocomplete (Gemini cloud, Ollama/MLX local, or auto fallback)."
        },
        "rursor.autocomplete.localEndpoint": {
          "type": "string",
          "default": "http://127.0.0.1:11434",
          "description": "Local inference endpoint for Ollama or MLX Tab autocomplete."
        },
        "rursor.autocomplete.localModel": {
          "type": "string",
          "default": "qwen2.5-coder:7b",
          "description": "Local model identifier for Ollama or MLX Tab autocomplete."
        },
        "rursor.layout.windowLayout": {
          "type": "string",
          "default": "editor",
          "enum": ["agent", "editor"],
          "description": "Default window layout: Agent-first or Editor-first."
        },
        "rursor.layout.conversationDensity": {
          "type": "string",
          "default": "detailed",
          "enum": ["compact", "detailed", "verbose"],
          "description": "How much detail Agent tool calls show in the conversation."
        },
        "rursor.layout.showTitleBar": {
          "type": "boolean",
          "default": true,
          "description": "Show title bar in agent layout."
        },
        "rursor.layout.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show status bar at the bottom of the window."
        },
        "rursor.layout.reviewControlLocation": {
          "type": "string",
          "default": "breadcrumb",
          "enum": ["breadcrumb", "floating"],
          "description": "Show inline diff review controls in breadcrumbs or a floating island."
        },
        "rursor.layout.autoHideEditorWhenEmpty": {
          "type": "boolean",
          "default": false,
          "description": "When all editors are closed, hide the editor area and maximize chat."
        },
        "rursor.layout.openChatAsEditorTabs": {
          "type": "boolean",
          "default": true,
          "description": "Open Agent chats as editor tabs instead of only the sidebar."
        },
        "rursor.ui.customizeBannerDismissed": {
          "type": "boolean",
          "default": false,
          "description": "Whether the Customize migration banner in Settings has been dismissed."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.95.0",
    "typescript": "^5.6.0"
  }
}
