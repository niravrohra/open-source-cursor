{
  "name": "rursor-ai",
  "displayName": "Rursor AI",
  "description": "Built-in AI editing, Tab autocomplete, codebase context, and Gemini-powered agent runtime for Rursor.",
  "publisher": "rursor",
  "version": "0.2.0",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "rursor-sidebar",
          "title": "Rursor AI",
          "icon": "$(sparkle)"
        }
      ]
    },
    "views": {
      "rursor-sidebar": [
        {
          "type": "webview",
          "id": "rursor.agentView",
          "name": "Agent"
        }
      ]
    },
    "commands": [
      {
        "command": "rursor.setApiKey",
        "title": "Rursor: Set Gemini API Key"
      },
      {
        "command": "rursor.setAnthropicApiKey",
        "title": "Rursor: Set Anthropic API Key"
      },
      {
        "command": "rursor.setOpenAiApiKey",
        "title": "Rursor: Set OpenAI API Key"
      },
      {
        "command": "rursor.status",
        "title": "Rursor: Show Sidecar Status"
      },
      {
        "command": "rursor.reindex",
        "title": "Rursor: Reindex Workspace"
      },
      {
        "command": "rursor.inlineEdit",
        "title": "Rursor: Inline Edit"
      },
      {
        "command": "rursor.fixDiagnostics",
        "title": "Rursor: Fix Diagnostics"
      },
      {
        "command": "rursor.acceptInlineEdit",
        "title": "Rursor: Accept Inline Edit"
      },
      {
        "command": "rursor.revertInlineEdit",
        "title": "Rursor: Revert Inline Edit"
      },
      {
        "command": "rursor.refineInlineEdit",
        "title": "Rursor: Refine Inline Edit"
      },
      {
        "command": "rursor.acceptNextEdit",
        "title": "Rursor: Accept Next Edit"
      },
      {
        "command": "rursor.dismissNextEdit",
        "title": "Rursor: Dismiss Next Edit"
      },
      {
        "command": "rursor.jumpToNextEdit",
        "title": "Rursor: Jump to Next Edit"
      },
      {
        "command": "rursor.acceptNextWord",
        "title": "Rursor: Accept Next Word"
      },
      {
        "command": "rursor.toggleAutocomplete",
        "title": "Rursor: Toggle Tab Autocomplete"
      },
      {
        "command": "rursor.openAgent",
        "title": "Rursor: Open Agent Panel"
      },
      {
        "command": "rursor.reloadMcp",
        "title": "Rursor: Reload MCP Servers"
      },
      {
        "command": "rursor.openPreview",
        "title": "Rursor: Open Web Preview"
      },
      {
        "command": "rursor.restoreCheckpoint",
        "title": "Rursor: Restore Agent Checkpoint"
      },
      {
        "command": "rursor.manageWorktrees",
        "title": "Rursor: Manage Git Worktree Sandboxes"
      }
    ],
    "keybindings": [
      {
        "command": "rursor.inlineEdit",
        "key": "cmd+k",
        "mac": "cmd+k",
        "when": "editorTextFocus"
      },
      {
        "command": "rursor.openAgent",
        "key": "cmd+l",
        "mac": "cmd+l"
      },
      {
        "command": "rursor.acceptInlineEdit",
        "key": "cmd+y",
        "mac": "cmd+y",
        "when": "editorTextFocus && rursor.hasActiveInlineEdit"
      },
      {
        "command": "rursor.revertInlineEdit",
        "key": "cmd+n",
        "mac": "cmd+n",
        "when": "editorTextFocus && rursor.hasActiveInlineEdit"
      },
      {
        "command": "rursor.acceptNextEdit",
        "key": "tab",
        "mac": "tab",
        "when": "editorTextFocus && rursor.hasNextEdit"
      },
      {
        "command": "rursor.jumpToNextEdit",
        "key": "tab",
        "mac": "tab",
        "when": "editorTextFocus && rursor.hasJumpTarget && !rursor.hasNextEdit"
      },
      {
        "command": "rursor.dismissNextEdit",
        "key": "escape",
        "mac": "escape",
        "when": "editorTextFocus && (rursor.hasNextEdit || rursor.hasJumpTarget)"
      },
      {
        "command": "rursor.acceptNextWord",
        "key": "cmd+right",
        "mac": "cmd+right",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "Rursor AI",
      "properties": {
        "rursor.defaultModel": {
          "type": "string",
          "default": "gemini-2.5-flash",
          "enum": [
            "auto",
            "gemini-2.5-flash",
            "gemini-2.5-pro",
            "gemini-2.5-flash-lite",
            "claude-sonnet-4-20250514",
            "claude-3-5-haiku-latest",
            "gpt-4o-mini",
            "o3-mini"
          ],
          "description": "Default model or Smart Router mode for Rursor Agent and Inline Edit."
        },
        "rursor.agent.autoVerify": {
          "type": "boolean",
          "default": false,
          "description": "Automatically run detected project test/typecheck commands after Agent edits and loop on failures."
        },
        "rursor.agent.thinkingBudget": {
          "type": "number",
          "default": 0,
          "description": "Optional thinking token budget for Gemini 2.5 reasoning turns (0 = automatic)."
        },
        "rursor.agent.promptCache": {
          "type": "boolean",
          "default": true,
          "description": "Enable Gemini Context Caching for large static project rules and memory prefixes."
        },
        "rursor.agent.usePty": {
          "type": "boolean",
          "default": true,
          "description": "Run Agent shell commands inside a real PTY via portable-pty in the Rust sidecar."
        },
        "rursor.autocomplete.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable low-latency Tab ghost-text autocomplete via Gemini."
        },
        "rursor.autocomplete.model": {
          "type": "string",
          "default": "gemini-2.5-flash-lite",
          "description": "Gemini model used for Tab autocomplete."
        },
        "rursor.autocomplete.backend": {
          "type": "string",
          "default": "gemini",
          "enum": [
            "gemini",
            "auto",
            "ollama",
            "mlx"
          ],
          "description": "Backend used for Tab autocomplete (Gemini cloud, Ollama/MLX local, or auto fallback)."
        },
        "rursor.autocomplete.localEndpoint": {
          "type": "string",
          "default": "http://127.0.0.1:11434",
          "description": "Local inference endpoint for Ollama or MLX Tab autocomplete."
        },
        "rursor.autocomplete.localModel": {
          "type": "string",
          "default": "qwen2.5-coder:7b",
          "description": "Local model identifier for Ollama or MLX Tab autocomplete."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.95.0",
    "typescript": "^5.6.0"
  }
}