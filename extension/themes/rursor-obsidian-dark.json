  "semanticTokenColors": {
    "namespace": "#a3a3a3",
    "type": "#5EEAD4",
    "class": "#5EEAD4",
    "interface": "#d4d4d4",
    "struct": "#5EEAD4",
    "enum": "#d4d4d4",
    "enumMember": "#FBBF24",
    "typeParameter": "#d4d4d4",
    "function": "#e5e5e5",
    "method": "#e5e5e5",
    "macro": {
      "foreground": "#d4d4d4",
      "fontStyle": "bold"
    },
    "decorator": "#d4d4d4",
    "variable": "#e5e5e5",
    "variable.readonly": "#d4d4d4",
    "variable.mutable": {
      "foreground": "#fafafa",
      "fontStyle": "underline"
    },
    "parameter": "#e5e5e5",
    "property": "#d4d4d4",
    "keyword": "#d4d4d4",
    "selfKeyword": {
      "foreground": "#F472B6",
      "fontStyle": "italic"
    },
    "lifetime": {
      "foreground": "#F472B6",
      "fontStyle": "italic"
    }
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6b6b6b",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Doc Comments",
      "scope": [
        "comment.block.documentation",
        "comment.line.documentation",
        "storage.type.class.jsdoc"
      ],
      "settings": {
        "foreground": "#8a8a8a",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#6EE7B7"
      }
    },
    {
      "name": "Regex & Escape Sequences",
      "scope": [
        "string.regexp",
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#d4d4d4"
      }
    },
    {
      "name": "Template Interpolation",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded",
        "constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#e5e5e5"
      }
    },
    {
      "name": "Numbers, Booleans & Constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "support.constant"
      ],
      "settings": {
        "foreground": "#FBBF24"
      }
    },
    {
      "name": "Keywords & Control Flow",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.control.flow",
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from",
        "keyword.control.conditional",
        "keyword.control.loop"
      ],
      "settings": {
        "foreground": "#d4d4d4"
      }
    },
    {
      "name": "Storage Types & Modifiers",
      "scope": [
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#d4d4d4"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.comparison",
        "keyword.operator.logical",
        "keyword.operator.arithmetic",
        "keyword.operator.type"
      ],
      "settings": {
        "foreground": "#f5f5f5"
      }
    },
    {
      "name": "Punctuation & Delimiters",
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#a3a3a3"
      }
    },
    {
      "name": "Functions & Methods",
      "scope": [
        "entity.name.function",
        "meta.function-call entity.name.function",
        "support.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#e5e5e5"
      }
    },
    {
      "name": "Types, Classes, Structs & Traits",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.struct",
        "entity.name.enum",
        "entity.name.trait",
        "entity.other.inherited-class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#d4d4d4"
      }
