  "semanticTokenColors": {
    "namespace": "#94A3B8",
    "type": "#5EEAD4",
    "class": "#5EEAD4",
    "interface": "#67E8F9",
    "struct": "#5EEAD4",
    "enum": "#67E8F9",
    "enumMember": "#FBBF24",
    "typeParameter": "#C4B5FD",
    "function": "#38BDF8",
    "method": "#38BDF8",
    "macro": {
      "foreground": "#A78BFA",
      "fontStyle": "bold"
    },
    "decorator": "#A78BFA",
    "variable": "#E2E8F0",
    "variable.readonly": "#CBD5E1",
    "variable.mutable": {
      "foreground": "#F8FAFC",
      "fontStyle": "underline"
    },
    "parameter": "#DDD6FE",
    "property": "#BAE6FD",
    "keyword": "#A78BFA",
    "selfKeyword": {
      "foreground": "#F472B6",
      "fontStyle": "italic"
    },
    "lifetime": {
      "foreground": "#F472B6",
      "fontStyle": "italic"
    }
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#56657E",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Doc Comments",
      "scope": [
        "comment.block.documentation",
        "comment.line.documentation",
        "storage.type.class.jsdoc"
      ],
      "settings": {
        "foreground": "#6C7F9E",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#6EE7B7"
      }
    },
    {
      "name": "Regex & Escape Sequences",
      "scope": [
        "string.regexp",
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#67E8F9"
      }
    },
    {
      "name": "Template Interpolation",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded",
        "constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#38BDF8"
      }
    },
    {
      "name": "Numbers, Booleans & Constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "support.constant"
      ],
      "settings": {
        "foreground": "#FBBF24"
      }
    },
    {
      "name": "Keywords & Control Flow",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.control.flow",
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from",
        "keyword.control.conditional",
        "keyword.control.loop"
      ],
      "settings": {
        "foreground": "#A78BFA"
      }
    },
    {
      "name": "Storage Types & Modifiers",
      "scope": [
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#A78BFA"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.comparison",
        "keyword.operator.logical",
        "keyword.operator.arithmetic",
        "keyword.operator.type"
      ],
      "settings": {
        "foreground": "#7DD3FC"
      }
    },
    {
      "name": "Punctuation & Delimiters",
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#8B9BB4"
      }
    },
    {
      "name": "Functions & Methods",
      "scope": [
        "entity.name.function",
        "meta.function-call entity.name.function",
        "support.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#38BDF8"
      }
    },
    {
      "name": "Types, Classes, Structs & Traits",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.struct",
        "entity.name.enum",
        "entity.name.trait",
        "entity.other.inherited-class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#5EEAD4"
      }
    },
    {
      "name": "Interfaces & Type Parameters",
      "scope": [
        "entity.name.type.interface",
        "entity.name.type.parameter",
        "meta.type.parameters entity.name.type"
      ],
      "settings": {
        "foreground": "#67E8F9"
      }
    },
    {
      "name": "Variables & Identifiers",
      "scope": [
        "variable",
        "variable.other.readwrite",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#E2E8F0"
      }
    },
    {
      "name": "Function Parameters",
      "scope": [
        "variable.parameter",
        "meta.parameter"
      ],
      "settings": {
        "foreground": "#DDD6FE"
      }
    },
    {
