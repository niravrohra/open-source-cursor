+class RursorAgentPillActionViewItem extends BaseActionViewItem {
+
+	constructor(
+		action: IAction,
+		private readonly hoverDelegate: IHoverDelegate,
+		options: IBaseActionViewItemOptions,
+		@IHoverService private readonly hoverService: IHoverService,
+	) {
+		super(undefined, action, options);
+	}
+
+	override render(container: HTMLElement): void {
+		super.render(container);
+
+		const pill = append(container, $('div.rursor-titlebar-pill'));
+		pill.setAttribute('role', 'button');
+		pill.tabIndex = 0;
+		pill.setAttribute('aria-label', localize('rursor.titlebar.pillAria', "Agents Window"));
+
+		const label = append(pill, $('span.rursor-titlebar-pill-label'));
+		label.textContent = 'Agents Window';
+
+		const icon = append(pill, $('span'));
+		icon.classList.add(...ThemeIcon.asClassNameArray(Codicon.linkExternal));
+
+		this._register(this.hoverService.setupManagedHover(
+			this.hoverDelegate,
+			pill,
+			localize('rursor.titlebar.pillTooltip', "Open Agents Window ({0})", isMacintosh ? 'Cmd+L' : 'Ctrl+L')
+		));
+
+		this._register(addDisposableListener(pill, EventType.CLICK, e => {
+			EventHelper.stop(e, true);
+			this.actionRunner.run(this._action, this._context);
+		}));
+
+		this._register(addDisposableListener(pill, EventType.KEY_DOWN, e => {
+			const event = new StandardKeyboardEvent(e);
+			if (event.equals(KeyCode.Enter) || event.equals(KeyCode.Space)) {
+				EventHelper.stop(e, true);
+				this.actionRunner.run(this._action, this._context);
+			}
+		}));
+	}
+}
