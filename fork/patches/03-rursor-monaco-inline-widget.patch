+
+.monaco-editor .zone-widget.rursor-inline-edit-zone > .zone-widget-container {
+	border-top-width: 0 !important;
+	border-bottom-width: 0 !important;
+	background: transparent;
+	overflow: visible !important;
+}
+
+.monaco-editor .rursor-inline-edit-card {
+	display: flex;
+	flex-direction: column;
+	gap: 6px;
+	margin: 2px 16px 2px 4px;
+	padding: 8px 10px;
+	border-radius: 8px;
+	border: 1px solid var(--vscode-focusBorder, var(--vscode-editorWidget-border, rgba(128, 128, 128, 0.45)));
+	background-color: var(--vscode-editorWidget-background, var(--vscode-editor-background));
+	color: var(--vscode-editorWidget-foreground, var(--vscode-foreground));
+	box-shadow: 0 6px 20px rgba(0, 0, 0, 0.28);
+	font-family: var(--monaco-font-family, sans-serif);
+	font-size: 12px;
+	box-sizing: border-box;
+}
+
+.monaco-editor .rursor-inline-header {
+	display: flex;
+	align-items: center;
+	justify-content: space-between;
+	gap: 8px;
+}
+
+.monaco-editor .rursor-inline-title-group {
+	display: flex;
+	align-items: center;
+	gap: 6px;
+	font-weight: 600;
+	font-size: 11px;
+}
+
+.monaco-editor .rursor-inline-range-badge {
+	font-family: var(--monaco-monospace-font);
+	font-size: 10px;
+	font-weight: 500;
+	padding: 1px 6px;
+	border-radius: 4px;
+	background-color: rgba(128, 128, 128, 0.18);
+	opacity: 0.85;
+}
+
+.monaco-editor .rursor-inline-status {
+	font-size: 11px;
+	opacity: 0.8;
+	display: flex;
+	align-items: center;
+	gap: 4px;
+}
+
+.monaco-editor .rursor-inline-input-row {
+	display: flex;
+	align-items: center;
+	gap: 6px;
+}
+
+.monaco-editor .rursor-inline-input {
+	flex: 1;
+	min-width: 0;
+	height: 26px;
+	padding: 3px 8px;
+	border-radius: 5px;
+	border: 1px solid var(--vscode-input-border, rgba(128, 128, 128, 0.35));
+	background-color: var(--vscode-input-background, rgba(0, 0, 0, 0.2));
+	color: var(--vscode-input-foreground, inherit);
+	font-family: inherit;
+	font-size: 12px;
+	outline: none;
+	box-sizing: border-box;
+}
+
+.monaco-editor .rursor-inline-input:focus {
+	border-color: var(--vscode-focusBorder, #007fd4);
+}
+
+.monaco-editor .rursor-inline-input::placeholder {
+	color: var(--vscode-input-placeholderForeground, rgba(128, 128, 128, 0.75));
+}
+
+.monaco-editor .rursor-inline-btn {
+	height: 26px;
+	padding: 0 9px;
+	border-radius: 5px;
+	border: 1px solid var(--vscode-button-border, transparent);
+	background-color: var(--vscode-button-secondaryBackground, rgba(128, 128, 128, 0.18));
+	color: var(--vscode-button-secondaryForeground, inherit);
+	font-size: 11px;
+	font-weight: 500;
+	cursor: pointer;
+	white-space: nowrap;
+}
+
+.monaco-editor .rursor-inline-btn:hover {
+	background-color: var(--vscode-button-secondaryHoverBackground, rgba(128, 128, 128, 0.28));
+}
+
+.monaco-editor .rursor-inline-btn.primary {
+	background-color: var(--vscode-button-background, #0078d4);
+	color: var(--vscode-button-foreground, #ffffff);
+}
+
+.monaco-editor .rursor-inline-btn.primary:hover {
+	background-color: var(--vscode-button-hoverBackground, #106ebe);
+}
+
+.monaco-editor .rursor-inline-btn.accept {
+	background-color: rgba(46, 160, 67, 0.85);
+	color: #ffffff;
+}
+
+.monaco-editor .rursor-inline-btn.revert {
+	background-color: rgba(248, 81, 73, 0.22);
+	border-color: rgba(248, 81, 73, 0.5);
+}
+
+.monaco-editor .rursor-inline-presets {
+	display: flex;
+	flex-wrap: wrap;
+	align-items: center;
+	gap: 5px;
+}
+
+.monaco-editor .rursor-inline-chip {
+	padding: 2px 7px;
+	border-radius: 999px;
+	border: 1px solid rgba(128, 128, 128, 0.28);
+	background: rgba(128, 128, 128, 0.1);
+	color: inherit;
+	font-size: 10px;
+	cursor: pointer;
+}
+
+.monaco-editor .rursor-inline-chip:hover {
+	background: rgba(128, 128, 128, 0.22);
+}
+
+.monaco-editor .rursor-inline-diff-preview {
+	display: none;
+	max-height: 110px;
+	overflow-y: auto;
+	border-radius: 5px;
+	border: 1px solid rgba(128, 128, 128, 0.28);
+	background-color: var(--vscode-editor-background);
+	font-family: var(--monaco-monospace-font);
+	font-size: 11px;
+	line-height: 16px;
+	padding: 4px 0;
+}
+
+.monaco-editor .rursor-inline-diff-preview.visible {
+	display: block;
+}
+
+.monaco-editor .rursor-inline-diff-line {
+	padding: 0 8px;
+	white-space: pre;
+	overflow: hidden;
+	text-overflow: ellipsis;
+}
+
+.monaco-editor .rursor-inline-diff-line.added {
+	background-color: rgba(46, 160, 67, 0.18);
+	border-left: 3px solid rgba(46, 160, 67, 0.9);
+}
+
+.monaco-editor .rursor-inline-diff-line.removed {
+	background-color: rgba(248, 81, 73, 0.18);
+	border-left: 3px solid rgba(248, 81, 73, 0.9);
+	text-decoration: line-through;
+	opacity: 0.85;
+}
+
+.monaco-editor .rursor-inline-diff-line.same {
+	opacity: 0.7;
+	border-left: 3px solid transparent;
+}
+
+/* Editor Model Decorations for target range and live streaming hunks */
+.monaco-editor .rursor-inline-target-range {
+	background-color: rgba(56, 139, 253, 0.12);
+	border-left: 2px solid rgba(56, 139, 253, 0.75);
+}
+
+.monaco-editor .rursor-inline-diff-added-line {
+	background-color: rgba(46, 160, 67, 0.22);
+	border-left: 3px solid rgba(46, 160, 67, 0.9);
+}
+
+.monaco-editor .rursor-inline-diff-removed-line {
+	background-color: rgba(248, 81, 73, 0.22);
+	border-left: 3px solid rgba(248, 81, 73, 0.9);
+	text-decoration: line-through;
+	opacity: 0.82;
+}
